# ---------------------------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง  (คำสั่ง: copy .env.example .env)
# ห้าม commit ไฟล์ .env ขึ้น git เด็ดขาด
# ---------------------------------------------------------------------------

# จาก LINE Developers Console > Channel ของคุณ > แท็บ "Messaging API"
# หัวข้อ "Channel access token (long-lived)" > กด Issue
LINE_CHANNEL_ACCESS_TOKEN=ใส่_channel_access_token_ที่นี่

# จาก LINE Developers Console > Channel ของคุณ > แท็บ "Basic settings"
# หัวข้อ "Channel secret"
LINE_CHANNEL_SECRET=ใส่_channel_secret_ที่นี่

# ไอดี LINE Official Account เช่น @123abcde
# ดูได้ที่ LINE Developers Console > แท็บ Messaging API > หัวข้อ Bot basic ID
# ใส่แล้วหน้าเว็บจะมีปุ่ม "เพิ่มเพื่อน" และบอทจะแนบลิงก์ส่งต่อให้เพื่อนท้ายข้อความเตือน
LINE_OA_ID=

# พอร์ตที่เซิร์ฟเวอร์จะรัน (ตอนรันในเครื่องใช้ 3000 ได้เลย)
# Railway / Render จะกำหนดค่านี้ให้เองอัตโนมัติ ไม่ต้องตั้ง
PORT=3000

# กุญแจลับสำหรับหน้าผู้ดูแล (/admin.html และ endpoint /admin/*)
# ถ้าเว้นว่างไว้ = ปิดส่วนผู้ดูแลทั้งหมด (กดยืนยันที่พักไม่ได้)
ADMIN_API_KEY=

# ---------------------------------------------------------------------------
# ข้อมูลผู้ควบคุมข้อมูลส่วนบุคคล — จะไปแสดงในหนังสือยินยอม PDPA
# ต้องกรอกก่อนเปิดให้คนนอกลงทะเบียนจริง
# ---------------------------------------------------------------------------

# ชื่อบริการที่แสดงต่อผู้ใช้ (เว้นว่าง = "เช็คก่อนโอน")
SITE_NAME=

# โดเมนจริงหลัง deploy เช่น https://xxx.up.railway.app
# ใช้สร้าง sitemap.xml ให้ Google เก็บหน้าเว็บได้ถูกต้อง ต้องใส่หลัง deploy
BASE_URL=

# ชื่อบุคคล กลุ่ม หรือหน่วยงานที่ดูแลระบบนี้
ORG_NAME=

# ช่องทางติดต่อสำหรับขอแก้ไข ลบข้อมูล หรือถอนความยินยอม (อีเมล/เบอร์โทร/LINE)
ORG_CONTACT=
